# Copy to .env for local runs. Never commit .env. Loaded two ways:
#   - `docker run --env-file .env ...`
#   - automatically by Spring on local runs (spring.config.import in application.yml, `optional:`)
# Keys mirror AGENTS.md "환경변수 / 설정".

# DB: application.yml defaults (localhost:5433, grape/grape) already cover local dev; leaving these
# uncommented overrides them. Uncomment + adjust ONLY for `docker run --env-file .env`.
#SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5433/grape
#SPRING_DATASOURCE_USERNAME=grape
#SPRING_DATASOURCE_PASSWORD=grape

JWT_SECRET=change-me-to-a-random-32-byte-min-secret
# JWT_ACCESS_TTL=1h
# JWT_REFRESH_TTL=30d

# Google Cloud Console에서 발급한 "Web application" 유형 OAuth 2.0 클라이언트 ID.
# idToken의 aud 클레임과 문자열 그대로 비교됨(GoogleTokeninfoVerifier).
# 클라이언트(grape) 리포의 EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID와 동일한 값이어야 함.
# Web 클라이언트 시크릿(GOCSPX-...)은 이 플로우에 불필요.
GOOGLE_OAUTH_CLIENT_ID=

# iOS/Android 네이티브 유형 OAuth 클라이언트 ID. 네이티브 로그인은 auth-code+PKCE로 토큰을
# 교환하므로 idToken의 aud가 웹이 아닌 네이티브 클라이언트다(kkori-api와 동일하게 aud 다중 허용).
# 클라이언트의 EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID / EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID와 동일.
# 해당 플랫폼 로그인을 안 쓰면 비워 둠.
GOOGLE_IOS_OAUTH_CLIENT_ID=
GOOGLE_ANDROID_OAUTH_CLIENT_ID=

# 카카오 REST API 키. POST /api/auth/kakao/web에서 authorization code를 access token으로
# 교환할 때 client_id로 사용(https://kauth.kakao.com/oauth/token).
# code를 발급받은 클라이언트(grape)의 EXPO_PUBLIC_KAKAO_REST_API_KEY와 반드시 같은 Kakao 앱의
# 키여야 함(불일치 시 카카오가 KOE101/invalid_client 반환). redirect_uri도 authorize 요청과 동일해야 함.
KAKAO_REST_API_KEY=
# 카카오 개발자 콘솔에서 "보안 > Client Secret"을 사용함으로 설정한 경우에만 필요. 그 외 비워 둠.
KAKAO_CLIENT_SECRET=

# SERVER_PORT=8080
